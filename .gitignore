.venv
.venv.old
.env
__pycache__/
*.log
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Runtime data and logs. Anchored to the repo root with a leading slash so
# these patterns cannot swallow source directories that happen to share a
# name -- src/minus/memory/ is code, /memory/ is this machine's data. The
# old unanchored "memory/" needed a "!src/memory" negation to stay tracked,
# which would have silently broken when the package moved one level deeper.
/logs/
/memory/
/quarantine/
/library/

# Sandbox base image, per-run overlays, downloaded Sysmon/VLC zips and review
# probes. Large, machine-specific, never tracked.
/vm/

# Rust build artifacts. The core is source; target/ is machine-specific and
# multi-gigabyte, so it must never be staged.
/rust/minus-core/target/

# claude worktrees
.claude/worktrees